#!/bin/sh
# Kintsugi pre-commit: the copy linter (docs/voice.md) on staged files only.
# Installed by `pnpm install` (the root `prepare` script sets core.hooksPath).
# A line that must keep its wording can carry `copy-lint-allow: <reason>`.
cd "$(git rev-parse --show-toplevel)" || exit 1
command -v node >/dev/null 2>&1 || { echo "pre-commit: node not found; skipping lint:copy" >&2; exit 0; }
exec node scripts/lint-copy.mjs --staged
