{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kintsugi",
  "version": "0.1.0",
  "identifier": "dev.phalasiya.kintsugi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kintsugi",
        "width": 1200,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "© 2026 Hussain Phalasiya",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0NjYxQkZCMjk3OThFQkMKUldTOGpua3AreHRtdEp5cG15ZHV2QmZjTTI1by9IS0dUUG1rdTlUTjRUaEFOU3RhQTJqTmlOZloK",
      "endpoints": [
        "https://github.com/hussainph/kintsugi/releases/latest/download/latest.json"
      ]
    }
  }
}
